# Production: point the app at your own proxy so the vendor key never ships.
API_PROXY_URL=https://map-api.example.workers.dev

# Local development only. Anything set here is readable in the app bundle.
FMP_API_KEY=

# RevenueCat public SDK keys (safe to ship; they are per-platform and public).
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
